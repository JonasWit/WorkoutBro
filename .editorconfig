root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,yml,yaml}]
trim_trailing_whitespace = false

[*.{kt,kts}]
# The application id keeps `wtk_apps` from before this setup; the underscore is why the
# package-name rule stays off. Changing the id again is a separate change.
ktlint_standard_package-name = disabled
# Compose composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
